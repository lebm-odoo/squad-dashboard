{
  "name": "@sd/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun ./node_modules/vite/bin/vite.js dev",
    "build": "bun --bun ./node_modules/vite/bin/vite.js build",
    "preview": "bun --bun ./node_modules/vite/bin/vite.js preview",
    "prepare": "bun --bun ./node_modules/@sveltejs/kit/svelte-kit.js sync || echo ''",
    "check": "bun --bun ./node_modules/@sveltejs/kit/svelte-kit.js sync && bun --bun ./node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.json",
    "test": "bun --bun ./node_modules/vitest/vitest.mjs --run --passWithNoTests"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@sd/server": "workspace:*",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.1.7",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.8"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@lucide/svelte": "0.561.0",
    "@tanstack/svelte-query": "6.3.1",
    "@tanstack/table-core": "8.21.3",
    "@sd/shared": "workspace:*",
    "bits-ui": "2.19.4",
    "cn": "0.3.3",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "hono": "4.13.13",
    "layerchart": "2.5.1",
    "mode-watcher": "1.1.0",
    "svelte-sonner": "1.2.1",
    "tailwind-variants": "3.3.1",
    "tw-animate-css": "1.4.0"
  }
}
